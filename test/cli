#!/bin/bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
status=0
shopt -s nullglob
suites=("$ROOT/test/cli.d"/*-test.sh)
if ((${#suites[@]} == 0)); then
  printf 'not ok - test/cli.d suites exist\n' >&2
  exit 1
fi
for suite in "${suites[@]}"; do
  if ! "$suite"; then
    printf 'FAIL %s\n' "${suite##*/}" >&2
    status=1
    break
  fi
done
exit $status
