#!/bin/bash
# gesso:summary=Restore Breeze if Gesso last applied a color scheme
# gesso:args=

set -euo pipefail

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  printf 'Usage: gesso theme restore\n'
  exit 0
fi

state=$HOME/.local/state/gesso
vscode_dirs=("$HOME/.config/Code/User" "$HOME/.var/app/com.visualstudio.code/config/Code/User")
vscode_backups=("$state/vscode-colorCustomizations.json" "$state/vscode-flatpak-colorCustomizations.json")
for i in "${!vscode_dirs[@]}"; do
  if [[ -f ${vscode_backups[i]} && -d ${vscode_dirs[i]} ]]; then
    gesso-vscode-colors restore "${vscode_dirs[i]}/settings.json" "${vscode_backups[i]}"
  fi
done

konsole_backup=$state/konsole-default-profile
konsolerc=$HOME/.config/konsolerc
if [[ -f $konsole_backup ]]; then
  previous_profile=$(cat "$konsole_backup")
  if [[ -f $konsolerc ]]; then
    if [[ -n $previous_profile ]]; then
      escaped=${previous_profile//\\/\\\\}
      escaped=${escaped//\//\\/}
      escaped=${escaped//&/\\&}
      sed -i "s/^DefaultProfile=.*/DefaultProfile=$escaped/" "$konsolerc"
    else
      sed -i '/^DefaultProfile=/d' "$konsolerc"
    fi
  fi
  rm -f "$konsole_backup"
fi

undo_dir=$state/undo
kitty_state=
ghostty_state=
ghostty_theme=
foot_state=
prev_wallpaper=
if [[ -d $undo_dir ]]; then
  [[ -f $undo_dir/kitty-state ]] && kitty_state=$(cat "$undo_dir/kitty-state")
  [[ -f $undo_dir/ghostty-state ]] && ghostty_state=$(cat "$undo_dir/ghostty-state")
  [[ -f $undo_dir/ghostty-theme ]] && ghostty_theme=$(cat "$undo_dir/ghostty-theme")
  [[ -f $undo_dir/foot-state ]] && foot_state=$(cat "$undo_dir/foot-state")
  [[ -f $undo_dir/wallpaper ]] && prev_wallpaper=$(cat "$undo_dir/wallpaper")
fi

kitty_conf=$HOME/.config/kitty/kitty.conf
if [[ -f $kitty_conf ]]; then
  sed -i -E '/^[[:space:]]*include[[:space:]]+.*gesso-theme\.conf/d' "$kitty_conf"
  if [[ $kitty_state == "created" ]]; then
    if [[ ! -s $kitty_conf ]] || ! grep -q '[^[:space:]]' "$kitty_conf"; then
      rm -f "$kitty_conf"
    fi
  fi
fi
rm -f "$HOME/.config/kitty/gesso-theme.conf"

ghostty_conf=$HOME/.config/ghostty/config
if [[ -f $ghostty_conf ]]; then
  if [[ -n $ghostty_theme && $ghostty_theme != "Gesso" ]]; then
    sed -i -E "s/^[[:space:]]*theme[[:space:]]*=.*/theme = $ghostty_theme/" "$ghostty_conf"
  else
    sed -i -E '/^[[:space:]]*theme[[:space:]]*=[[:space:]]*Gesso[[:space:]]*$/d' "$ghostty_conf"
  fi
  if [[ $ghostty_state == "created" ]]; then
    if [[ ! -s $ghostty_conf ]] || ! grep -q '[^[:space:]]' "$ghostty_conf"; then
      rm -f "$ghostty_conf"
    fi
  fi
fi
rm -f "$HOME/.config/ghostty/themes/Gesso"

foot_conf=$HOME/.config/foot/foot.ini
if [[ -f $foot_conf ]]; then
  sed -i -E '/^[[:space:]]*include[[:space:]]*=[[:space:]]*.*gesso-theme\.ini/d' "$foot_conf"
  if [[ $foot_state == "created" ]]; then
    if ! grep -v -E '^[[:space:]]*(\[main\])?[[:space:]]*$' "$foot_conf" | grep -q '[^[:space:]]'; then
      rm -f "$foot_conf"
    fi
  fi
fi
rm -f "$HOME/.config/foot/gesso-theme.ini"

if [[ -z ${GESSO_THEME_HEADLESS:-} ]] && command -v plasma-apply-wallpaperimage >/dev/null; then
  if [[ -n $prev_wallpaper ]]; then
    plasma-apply-wallpaperimage "$prev_wallpaper" || true
  fi
fi

rm -rf "$undo_dir"
rm -f "$state/current/wallpaper"
rm -f "$HOME/.local/share/color-schemes/Gesso.colors"
rm -f "$HOME/.local/share/konsole/Gesso.colorscheme"
rm -f "$HOME/.local/share/konsole/Gesso.profile"

name_file=$state/current/theme.name
if [[ ! -f $name_file ]]; then
  exit 0
fi

scheme=BreezeDark
colors=$state/current/theme/colors.toml
if [[ -f $colors ]]; then
  mode=$(grep -E '^mode[[:space:]]*=' "$colors" | head -n1 | cut -d'"' -f2) || true
  if [[ $mode == "light" ]]; then
    scheme=BreezeLight
  fi
fi
rm -f "$name_file"

if [[ -n ${GESSO_THEME_HEADLESS:-} ]]; then
  exit 0
fi

if ! command -v plasma-apply-colorscheme >/dev/null; then
  printf 'plasma-apply-colorscheme is not available\n' >&2
  exit 1
fi
plasma-apply-colorscheme "$scheme"

gtk_backup=$state/gtk-color-scheme
if [[ -f $gtk_backup ]] && command -v gsettings >/dev/null; then
  previous_scheme=$(cat "$gtk_backup")
  if [[ -n $previous_scheme ]]; then
    gsettings set org.gnome.desktop.interface color-scheme "$previous_scheme" || true
  else
    gsettings reset org.gnome.desktop.interface color-scheme || true
  fi
  rm -f "$gtk_backup"
fi
