#!/bin/bash
# gesso:summary=Exit 0 if a catalog app is on the host or as Flatpak
# gesso:hidden=true
# gesso:args=[--desktop] <id>|--list --kind <kind>

set -euo pipefail

usage() {
  printf 'Usage: gesso-app-present [--desktop] <id>\n'
  printf '       gesso-app-present --list --kind <kind>\n'
}

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  usage
  exit 0
fi

present_flatpak=""

app_present() {
  local id=$1 app_cmd app_flatpak
  present_flatpak=""
  app_cmd=$(gesso-catalog-get "$id" command)
  if [[ -n $app_cmd ]] && gesso-cmd-present "$app_cmd"; then
    return 0
  fi
  app_flatpak=$(gesso-catalog-get "$id" flatpak)
  if [[ -n $app_flatpak ]] && flatpak info "$app_flatpak" >/dev/null 2>&1; then
    present_flatpak=$app_flatpak
    return 0
  fi
  return 1
}

host_desktop() {
  local id=$1 candidate flatpak_id dir base
  local -a dirs=()
  IFS=':' read -r -a dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for base in "${!dirs[@]}"; do
    dirs[base]=${dirs[base]}/applications
  done
  candidate=$(gesso-catalog-get "$id" desktop_id)
  for dir in "${dirs[@]}"; do
    if [[ -n $candidate && -f $dir/$candidate ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  # Fedora 44 renamed some desktop files to reverse-DNS ids (firefox.desktop
  # became org.mozilla.firefox.desktop). Prefer the one actually installed.
  flatpak_id=$(gesso-catalog-get "$id" flatpak)
  for dir in "${dirs[@]}"; do
    if [[ -n $flatpak_id && -f $dir/$flatpak_id.desktop ]]; then
      printf '%s\n' "$flatpak_id.desktop"
      return 0
    fi
  done
  printf '%s\n' "$candidate"
}

if [[ ${1:-} == "--list" ]]; then
  if (($# != 3)) || [[ $2 != "--kind" ]]; then
    usage >&2
    exit 1
  fi
  kind=$3
  mapfile -t ids < <(gesso-catalog-get --kind "$kind")
  for id in "${ids[@]}"; do
    if app_present "$id"; then
      printf '%s\n' "$id"
    fi
  done
  exit 0
fi

desktop=0
if [[ ${1:-} == "--desktop" ]]; then
  desktop=1
  shift
fi

if (($# != 1)); then
  usage >&2
  exit 1
fi

id=$1
if app_present "$id"; then
  if ((desktop == 1)); then
    if [[ -n $present_flatpak ]]; then
      printf '%s.desktop\n' "$present_flatpak"
    else
      host_desktop "$id"
    fi
  fi
  exit 0
fi

exit 1
