#!/bin/bash
# gesso:summary=Open Gesso Setup
# gesso:args=

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: gesso setup
Open Gesso Setup
EOF
}

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  usage
  exit 0
fi

missing() {
  printf 'Gesso Setup is not built. cmake -S setup -B setup/build && cmake --build setup/build\n' >&2
  exit 1
}

bin=""
if [[ -n ${GESSO_SETUP_BIN:-} ]]; then
  if [[ -x $GESSO_SETUP_BIN ]]; then
    bin=$GESSO_SETUP_BIN
  else
    missing
  fi
elif [[ -n ${GESSO_ROOT:-} && -x $GESSO_ROOT/setup/build/bin/gesso-setup ]]; then
  bin=$GESSO_ROOT/setup/build/bin/gesso-setup
elif [[ -n ${GESSO_ROOT:-} && -x $GESSO_ROOT/setup/build/gesso-setup ]]; then
  bin=$GESSO_ROOT/setup/build/gesso-setup
elif [[ -n ${GESSO_PATH:-} && -x $GESSO_PATH/setup/build/bin/gesso-setup ]]; then
  bin=$GESSO_PATH/setup/build/bin/gesso-setup
elif [[ -n ${GESSO_PATH:-} && -x $GESSO_PATH/setup/build/gesso-setup ]]; then
  bin=$GESSO_PATH/setup/build/gesso-setup
elif [[ -x /usr/libexec/gesso/gesso-setup ]]; then
  bin=/usr/libexec/gesso/gesso-setup
fi

if [[ -n $bin ]]; then
  exec "$bin" "$@"
fi

missing
