#!/bin/bash
# gesso:summary=Set or print the default browser
# gesso:args=[id]

set -euo pipefail

usage() {
  printf 'Usage: gesso default browser [id]\n'
}

# Fedora 44 ships qtpaths6 and qtpaths-qt6 but no bare qtpaths, and xdg-utils
# calls qtpaths on a KDE session. Unsetting KDE_SESSION_VERSION trips a
# separate xdg-utils bug, so put a qtpaths on PATH for the xdg-* calls.
if [[ -n ${KDE_SESSION_VERSION:-} ]] && ! command -v qtpaths >/dev/null; then
  qtpaths_real=$(command -v qtpaths6 || command -v qtpaths-qt6) || qtpaths_real=""
  if [[ -n $qtpaths_real ]]; then
    qtpaths_shim=$(mktemp -d)
    trap 'rm -rf "$qtpaths_shim"' EXIT
    ln -s "$qtpaths_real" "$qtpaths_shim/qtpaths"
    PATH="$qtpaths_shim:$PATH"
  fi
fi

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  usage
  exit 0
fi

if (($# == 0)); then
  current=""
  if current=$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null); then
    ids=$(gesso-catalog-get --kind browser)
    while IFS= read -r id; do
      [[ -n $id ]] || continue
      desktop=$(gesso-catalog-get "$id" desktop_id)
      if [[ $desktop == "$current" ]]; then
        printf '%s\n' "$id"
        exit 0
      fi
      app_flatpak=$(gesso-catalog-get "$id" flatpak)
      if [[ -n $app_flatpak && $app_flatpak.desktop == "$current" ]]; then
        printf '%s\n' "$id"
        exit 0
      fi
    done <<< "$ids"
  fi
  printf 'unset\n'
  exit 0
fi

id=$1
kind=""
if kind=$(gesso-catalog-get "$id" kind 2>/dev/null); then
  :
else
  printf 'Unknown browser: %s\n' "$id" >&2
  exit 1
fi

if [[ $kind != "browser" ]]; then
  printf 'Unknown browser: %s\n' "$id" >&2
  exit 1
fi

label=$(gesso-catalog-get "$id" label)

if ! gesso-app-present "$id"; then
  gesso pkg add "$id"
fi

desktop_id=$(gesso-app-present --desktop "$id")
env -u BROWSER xdg-settings set default-web-browser "$desktop_id"

if command -v notify-send >/dev/null; then
  notify-send "$label is now the default browser"
fi
