#!/bin/bash
# gesso:summary=Install a catalog app with dnf, then Flatpak
# gesso:args=<id>
# gesso:requires-sudo=true

set -euo pipefail

usage() {
  printf 'Usage: gesso pkg add <id>\n'
}

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  usage
  exit 0
fi

if (($# == 0)); then
  usage >&2
  exit 1
fi

id=$1
packages=$(gesso-catalog-get "$id" dnf)
app_flatpak=$(gesso-catalog-get "$id" flatpak)

if gesso-app-present "$id"; then
  exit 0
fi

elevate() {
  if ((EUID == 0)); then
    "$@"
  elif [[ -t 0 ]]; then
    sudo "$@"
  else
    pkexec "$@"
  fi
}

if [[ -n $packages ]]; then
  if elevate dnf install -y $packages; then
    if gesso-app-present "$id"; then
      exit 0
    fi
  fi
fi

if [[ -n $app_flatpak ]]; then
  flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  if flatpak install --user -y flathub "$app_flatpak"; then
    if gesso-app-present "$id"; then
      exit 0
    fi
  fi
fi

printf 'failed to install %s\n' "$id" >&2
exit 1
