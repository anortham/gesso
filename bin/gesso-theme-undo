#!/bin/bash
# gesso:summary=Undo the last applied Gesso theme
# gesso:args=

set -euo pipefail

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  printf 'Usage: gesso theme undo\n'
  exit 0
fi

bin_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export PATH="$bin_dir:$PATH"

state=$HOME/.local/state/gesso
undo_dir=$state/undo

if [[ ! -d $undo_dir ]]; then
  printf 'No previous theme to undo\n' >&2
  exit 1
fi

shopt -s nullglob dotglob
undo_files=("$undo_dir"/*)
if ((${#undo_files[@]} == 0)); then
  printf 'No previous theme to undo\n' >&2
  exit 1
fi

prev_theme=
if [[ -f $undo_dir/previous-theme.name ]]; then
  prev_theme=$(cat "$undo_dir/previous-theme.name")
fi

prev_wallpaper=
if [[ -f $undo_dir/wallpaper ]]; then
  prev_wallpaper=$(cat "$undo_dir/wallpaper")
fi

if [[ -n $prev_theme && $prev_theme != "unset" ]]; then
  if [[ -n $prev_wallpaper ]]; then
    if [[ -f $prev_wallpaper ]]; then
      wp_tmp=$(mktemp -d "$state/wp-undo.XXXXXX")
      cp -f "$prev_wallpaper" "$wp_tmp/$(basename "$prev_wallpaper")"
      gesso theme set "$prev_theme" --wallpaper "$wp_tmp/$(basename "$prev_wallpaper")"
      rm -rf "$wp_tmp"
    elif [[ -n ${GESSO_PATH:-} && -f $GESSO_PATH/themes/$prev_theme/backgrounds/$(basename "$prev_wallpaper") ]]; then
      gesso theme set "$prev_theme" --wallpaper theme
    elif [[ -f $HOME/.config/gesso/themes/$prev_theme/backgrounds/$(basename "$prev_wallpaper") ]]; then
      gesso theme set "$prev_theme" --wallpaper theme
    else
      gesso theme set "$prev_theme"
    fi
  else
    gesso theme set "$prev_theme"
  fi
  rm -rf "$undo_dir"
else
  gesso theme restore
fi
