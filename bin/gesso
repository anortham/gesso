#!/bin/bash
set -euo pipefail

GESSO_BIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
GESSO_ROOT=$(cd -- "$GESSO_BIN_DIR/.." && pwd)

if [[ -z ${GESSO_PATH:-} ]]; then
  if [[ -d $GESSO_ROOT/themes ]]; then
    export GESSO_PATH=$GESSO_ROOT
  else
    export GESSO_PATH=/usr/share/gesso
  fi
fi

export PATH="$GESSO_BIN_DIR:$PATH"

usage() {
  cat <<'EOF'
Usage: gesso <command> [args]

Commands:
  theme list       List available themes
  theme set        Apply a Gesso theme
  theme current    Print the current theme name
  theme restore    Restore Breeze if Gesso last applied a color scheme
  default browser  Set or print the default browser
  default terminal Set or print the default terminal
  default editor   Set or print the default editor
  default agent    Set or print the default coding agent
  pkg add          Install a catalog app
  agent            Launch the default coding agent
  setup            Open Gesso Setup
  commands         List commands

Use gesso <command> --help for a command's usage.
EOF
}

if (($# == 0)) || [[ $1 == "--help" || $1 == "-h" ]]; then
  usage
  exit 0
fi

if [[ $1 == "commands" ]]; then
  usage
  exit 0
fi

join_hyphen() {
  local joined="$1"
  shift
  local word
  for word in "$@"; do
    joined+="-$word"
  done
  printf '%s' "$joined"
}

list_group_commands() {
  local group=$1
  local prefix="gesso-${group}-"
  local cmd base rest name
  local -a names=()
  for cmd in "$GESSO_BIN_DIR/$prefix"*; do
    [[ -x $cmd ]] || continue
    if head -n 80 "$cmd" | grep -q '^# gesso:hidden=true'; then
      continue
    fi
    base=${cmd##*/}
    rest=${base#"$prefix"}
    name=${rest//-/ }
    names+=("$name")
  done
  if ((${#names[@]} == 0)); then
    return 1
  fi
  while IFS= read -r name; do
    printf '%s %s\n' "$group" "$name"
  done < <(printf '%s\n' "${names[@]}" | sort)
}

words=("$@")
i=${#words[@]}
found=""
leftover=()

while ((i >= 1)); do
  probe="gesso-$(join_hyphen "${words[@]:0:i}")"
  if [[ -x $GESSO_BIN_DIR/$probe ]]; then
    found=$probe
    leftover=("${words[@]:i}")
    break
  fi
  ((i--)) || true
done

if [[ -z $found ]]; then
  if (($# == 1)) && list_group_commands "$1"; then
    exit 0
  fi
  printf 'Unknown command: gesso %s\n' "$*" >&2
  usage >&2
  exit 1
fi

for arg in "${leftover[@]+"${leftover[@]}"}"; do
  if [[ $arg == "--" ]]; then
    break
  fi
  if [[ $arg == "--help" || $arg == "-h" ]]; then
    exec "$GESSO_BIN_DIR/$found" --help
  fi
done

exec "$GESSO_BIN_DIR/$found" "${leftover[@]+"${leftover[@]}"}"
