#!/bin/bash
set -euo pipefail

GESSO_SOURCE=${BASH_SOURCE[0]}
if [[ -L $GESSO_SOURCE ]]; then
  GESSO_SOURCE=$(readlink -f -- "$GESSO_SOURCE")
fi
GESSO_BIN_DIR=$(cd -- "$(dirname -- "$GESSO_SOURCE")" && pwd)
GESSO_ROOT=$(cd -- "$GESSO_BIN_DIR/.." && pwd)

if [[ -z ${GESSO_PATH:-} ]]; then
  if [[ -d $GESSO_ROOT/themes ]]; then
    export GESSO_PATH=$GESSO_ROOT
  else
    export GESSO_PATH=/usr/share/gesso
  fi
fi

export PATH="$GESSO_BIN_DIR:$PATH"

metadata_value() {
  local file=$1 key=$2
  head -n 80 "$file" | sed -n "0,/^# gesso:$key=/s/^# gesso:$key=//p"
}

command_label() {
  local stem=${1#gesso-}
  if [[ $stem == *-* ]]; then
    printf '%s %s' "${stem%%-*}" "${stem#*-}" | tr '-' ' '
  else
    printf '%s' "$stem"
  fi
}

usage() {
  local cmd summary label
  local -a rows=()
  for cmd in "$GESSO_BIN_DIR"/gesso-*; do
    [[ -x $cmd ]] || continue
    if head -n 80 "$cmd" | grep -q '^# gesso:hidden=true'; then
      continue
    fi
    summary=$(metadata_value "$cmd" summary)
    if head -n 80 "$cmd" | grep -q '^# gesso:requires-sudo=true'; then
      summary+=" (sudo)"
    fi
    rows+=("$(command_label "${cmd##*/}")"$'\t'"$summary")
  done
  printf 'Usage: gesso <command> [args]\n\nCommands:\n'
  if ((${#rows[@]} > 0)); then
    while IFS=$'\t' read -r label summary; do
      printf '  %-18s %s\n' "$label" "$summary"
    done < <(printf '%s\n' "${rows[@]}" | sort)
  fi
  printf '  %-18s %s\n' commands 'List commands'
  printf "\nUse gesso <command> --help for a command's usage.\n"
}

if (($# == 0)) || [[ $1 == "--help" || $1 == "-h" ]]; then
  usage
  exit 0
fi

if [[ $1 == "commands" ]]; then
  usage
  exit 0
fi

join_hyphen() {
  local joined="$1"
  shift
  local word
  for word in "$@"; do
    joined+="-$word"
  done
  printf '%s' "$joined"
}

list_group_commands() {
  local group=$1
  local prefix="gesso-${group}-"
  local cmd base rest name
  local -a names=()
  for cmd in "$GESSO_BIN_DIR/$prefix"*; do
    [[ -x $cmd ]] || continue
    if head -n 80 "$cmd" | grep -q '^# gesso:hidden=true'; then
      continue
    fi
    base=${cmd##*/}
    rest=${base#"$prefix"}
    name=${rest//-/ }
    names+=("$name")
  done
  if ((${#names[@]} == 0)); then
    return 1
  fi
  while IFS= read -r name; do
    printf '%s %s\n' "$group" "$name"
  done < <(printf '%s\n' "${names[@]}" | sort)
}

words=("$@")
i=${#words[@]}
found=""
leftover=()

while ((i >= 1)); do
  probe="gesso-$(join_hyphen "${words[@]:0:i}")"
  if [[ -x $GESSO_BIN_DIR/$probe ]]; then
    found=$probe
    leftover=("${words[@]:i}")
    break
  fi
  ((i--)) || true
done

if [[ -z $found ]]; then
  if (($# == 1)) && list_group_commands "$1"; then
    exit 0
  fi
  printf 'Unknown command: gesso %s\n' "$*" >&2
  usage >&2
  exit 1
fi

for arg in "${leftover[@]+"${leftover[@]}"}"; do
  if [[ $arg == "--" ]]; then
    break
  fi
  if [[ $arg == "--help" || $arg == "-h" ]]; then
    exec "$GESSO_BIN_DIR/$found" --help
  fi
done

if [[ $(metadata_value "$GESSO_BIN_DIR/$found" args) == *"<"* ]] && ((${#leftover[@]} == 0)); then
  "$GESSO_BIN_DIR/$found" --help >&2
  exit 1
fi

exec "$GESSO_BIN_DIR/$found" "${leftover[@]+"${leftover[@]}"}"
