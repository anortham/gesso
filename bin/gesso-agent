#!/bin/bash
# gesso:summary=Launch the default coding agent
# gesso:args=[-- prompt]

set -euo pipefail

usage() {
  printf 'Usage: gesso agent [-- prompt]\n'
}

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  usage
  exit 0
fi

if (($# > 0)) && [[ $1 != "--" ]]; then
  usage >&2
  exit 2
fi

agent_file=$HOME/.config/gesso/defaults/agent
id=""
if [[ -f $agent_file ]]; then
  id=$(cat "$agent_file")
fi
if [[ -z $id ]]; then
  printf 'Choose a default agent with: gesso default agent <name>\n' >&2
  exit 1
fi

prompt=""
if (($# > 0)); then
  shift
  if (($# > 0)); then
    prompt="$*"
  fi
fi

launch=$(gesso-agent-get "$id" launch)
read -r -a argv <<< "$launch"

if [[ -n $prompt ]]; then
  prompt_launch=$(gesso-agent-get "$id" prompt_launch)
  if [[ -n $prompt_launch ]]; then
    read -r -a argv <<< "$prompt_launch"
  else
    prompt_flag=$(gesso-agent-get "$id" prompt_flag)
    if [[ -n $prompt_flag ]]; then
      argv+=("$prompt_flag")
    fi
  fi
  argv+=("$prompt")
fi

find_mise() {
  if command -v mise; then
    return 0
  elif [[ -x $HOME/.local/bin/mise ]]; then
    printf '%s\n' "$HOME/.local/bin/mise"
    return 0
  else
    return 1
  fi
}

find_host_agent() {
  local bin=$1 candidate mise_data mise_shims
  if [[ -f $HOME/.local/bin/$bin && -x $HOME/.local/bin/$bin ]]; then
    printf '%s\n' "$HOME/.local/bin/$bin"
    return 0
  fi
  mise_data=${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}
  mise_shims=${mise_data%/}/shims
  while IFS= read -r candidate; do
    if [[ $candidate != /* ]]; then
      candidate=$PWD/$candidate
    fi
    if [[ ${candidate%/*} == "$mise_shims" ]]; then
      continue
    fi
    printf '%s\n' "$candidate"
    return 0
  done < <(type -P -a "$bin")
  return 1
}

if host_agent=$(find_host_agent "${argv[0]}"); then
  argv[0]=$host_agent
elif mise=$(find_mise); then
  if ! "$mise" which "${argv[0]}" >/dev/null 2>&1; then
    printf '%s is not installed\n' "${argv[0]}" >&2
    exit 1
  fi
  argv=("$mise" exec -- "${argv[@]}")
else
  printf '%s is not installed\n' "${argv[0]}" >&2
  exit 1
fi

if [[ $PWD == $HOME && -d $HOME/Work ]]; then
  cd "$HOME/Work"
fi

if [[ -n ${GESSO_AGENT_DRY_RUN:-} ]]; then
  printf 'cwd=%s\n' "$PWD"
  printf 'argv=%s\n' "${argv[*]}"
  exit 0
else
  gesso-agent-skills
  exec "${argv[@]}"
fi
