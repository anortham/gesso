#!/bin/bash
# gesso:summary=Read a field from the agent catalog
# gesso:hidden=true
# gesso:args=<id> <field>|--list

set -euo pipefail

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  printf 'Usage: gesso-agent-get <id> <field>\n'
  printf '       gesso-agent-get --list\n'
  exit 0
fi

if [[ -z ${GESSO_PATH:-} ]]; then
  printf 'GESSO_PATH is not set\n' >&2
  exit 1
fi

catalog=$GESSO_PATH/data/agents.toml
if [[ ! -f $catalog ]]; then
  printf 'catalog not found: %s\n' "$catalog" >&2
  exit 1
fi

python3 - "$catalog" "$@" <<'PY'
import sys
import tomllib
from pathlib import Path

catalog = Path(sys.argv[1])
args = sys.argv[2:]
data = tomllib.loads(catalog.read_text())
agents = data.get("agent") or []

if len(args) == 1 and args[0] == "--list":
    ids = [a["id"] for a in agents]
    if not ids:
        sys.exit(1)
    print("\n".join(ids))
    sys.exit(0)

if len(args) != 2:
    sys.stderr.write("Usage: gesso-agent-get <id> <field>\n")
    sys.exit(1)

agent_id, field = args
row = next((a for a in agents if a.get("id") == agent_id), None)
if row is None:
    sys.stderr.write(f"Unknown agent: {agent_id}\n")
    sys.exit(1)
if field not in row:
    if field == "prompt_flag":
        print("")
        sys.exit(0)
    if field == "prompt_launch":
        print("")
        sys.exit(0)
    sys.stderr.write(f"Unknown field: {field}\n")
    sys.exit(1)
value = row[field]
if isinstance(value, list):
    print(" ".join(str(v) for v in value))
else:
    print(value)
PY
