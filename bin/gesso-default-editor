#!/bin/bash
# gesso:summary=Set or print the default editor
# gesso:args=[id]

set -euo pipefail

usage() {
  printf 'Usage: gesso default editor [id]\n'
}

# Fedora 44 ships qtpaths6 and qtpaths-qt6 but no bare qtpaths, and xdg-utils
# calls qtpaths on a KDE session. Unsetting KDE_SESSION_VERSION trips a
# separate xdg-utils bug, so put a qtpaths on PATH for the xdg-* calls.
if [[ -n ${KDE_SESSION_VERSION:-} ]] && ! command -v qtpaths >/dev/null; then
  qtpaths_real=$(command -v qtpaths6 || command -v qtpaths-qt6) || qtpaths_real=""
  if [[ -n $qtpaths_real ]]; then
    qtpaths_shim=$(mktemp -d)
    trap 'rm -rf "$qtpaths_shim"' EXIT
    ln -s "$qtpaths_real" "$qtpaths_shim/qtpaths"
    PATH="$qtpaths_shim:$PATH"
  fi
fi

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  usage
  exit 0
fi

editor_file=$HOME/.local/state/gesso/defaults/editor

if (($# == 0)); then
  if [[ -f $editor_file ]]; then
    current=$(cat "$editor_file")
    if [[ -n $current ]]; then
      printf '%s\n' "$current"
      exit 0
    fi
  fi
  printf 'unset\n'
  exit 0
fi

id=$1
kind=""
if kind=$(gesso-catalog-get "$id" kind 2>/dev/null); then
  :
else
  printf 'Unknown editor: %s\n' "$id" >&2
  exit 1
fi

if [[ $kind != "editor" ]]; then
  printf 'Unknown editor: %s\n' "$id" >&2
  exit 1
fi

label=$(gesso-catalog-get "$id" label)

if ! gesso-app-present "$id"; then
  gesso pkg add "$id"
fi

mkdir -p "$(dirname "$editor_file")"
printf '%s\n' "$id" > "$editor_file"

mime_types=(
  text/plain
  text/markdown
  text/x-shellscript
  application/x-shellscript
  text/x-python
  application/json
  text/xml
  application/xml
  text/css
  text/javascript
  application/toml
  application/x-yaml
)
desktop_id=$(gesso-app-present --desktop "$id")
xdg-mime default "$desktop_id" "${mime_types[@]}"

if command -v notify-send >/dev/null; then
  notify-send "$label is now the default editor"
fi
