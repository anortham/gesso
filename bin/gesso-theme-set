#!/bin/bash
# gesso:summary=Apply a Gesso theme
# gesso:args=<name> [--wallpaper <keep|theme|path>]

set -euo pipefail

usage() {
  printf 'Usage: gesso theme set <name> [--wallpaper <keep|theme|path>]\n'
}

wallpaper_mode="keep"
wallpaper_arg=
name=

while (($# > 0)); do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --wallpaper)
      shift
      if (($# == 0)); then
        usage >&2
        exit 1
      fi
      if [[ $1 == "keep" || $1 == "theme" ]]; then
        wallpaper_mode=$1
      elif [[ $1 == "custom" ]]; then
        shift
        if (($# == 0)); then
          usage >&2
          exit 1
        fi
        wallpaper_mode="custom"
        wallpaper_arg=$1
      else
        wallpaper_mode="custom"
        wallpaper_arg=$1
      fi
      ;;
    --wallpaper=*)
      val=${1#*=}
      if [[ $val == "keep" || $val == "theme" ]]; then
        wallpaper_mode=$val
      else
        wallpaper_mode="custom"
        wallpaper_arg=$val
      fi
      ;;
    -*)
      usage >&2
      exit 1
      ;;
    *)
      if [[ -z $name ]]; then
        name=$1
      else
        usage >&2
        exit 1
      fi
      ;;
  esac
  shift
done

if [[ -z $name ]]; then
  usage >&2
  exit 1
fi

if [[ -z ${GESSO_PATH:-} ]]; then
  printf 'GESSO_PATH is not set\n' >&2
  exit 1
fi

if [[ ! $name =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  printf 'Unknown theme: %s\n' "$name" >&2
  exit 1
fi

if [[ $wallpaper_mode == "custom" ]]; then
  if [[ $wallpaper_arg == "~/"* ]]; then
    wallpaper_arg="$HOME/${wallpaper_arg#"~/"}"
  fi
  if [[ ! -f $wallpaper_arg ]]; then
    printf 'Wallpaper not found: %s\n' "$wallpaper_arg" >&2
    exit 1
  fi
fi

builtin_dir=$GESSO_PATH/themes/$name
user_dir=$HOME/.config/gesso/themes/$name

theme_dir_allowed() {
  local dir=$1
  local root=$2
  local canon_dir canon_root
  [[ -d $dir ]] || return 0
  [[ -d $root ]] || return 1
  canon_dir=$(cd -- "$dir" && pwd -P)
  canon_root=$(cd -- "$root" && pwd -P)
  [[ $canon_dir == "$canon_root" || $canon_dir == "$canon_root"/* ]]
}

if [[ ! -f $builtin_dir/colors.toml && ! -f $user_dir/colors.toml ]]; then
  printf 'Unknown theme: %s\n' "$name" >&2
  exit 1
fi
if ! theme_dir_allowed "$builtin_dir" "$GESSO_PATH/themes"; then
  printf 'Unknown theme: %s\n' "$name" >&2
  exit 1
fi
if ! theme_dir_allowed "$user_dir" "$HOME/.config/gesso/themes"; then
  printf 'Unknown theme: %s\n' "$name" >&2
  exit 1
fi

state_dir=$HOME/.local/state/gesso/current
next=$state_dir/next-theme
current=$state_dir/theme
undo_dir=$HOME/.local/state/gesso/undo
next_undo=$state_dir/next-undo
lock_dir=${XDG_RUNTIME_DIR:-$HOME/.local/state/gesso}
lock=$lock_dir/gesso-theme-set.lock

mkdir -p "$state_dir" "$lock_dir"
if [[ -z ${GESSO_LOCK_HELD:-} ]]; then
  exec 9>"$lock"
  flock 9
  export GESSO_LOCK_HELD=1
fi

ensure_trailing_newline() {
  local file=$1
  if [[ -f $file && -s $file ]]; then
    python3 -c '
import sys, os
path = sys.argv[1]
try:
    with open(path, "rb+") as fp:
        fp.seek(-1, os.SEEK_END)
        if fp.read(1) != b"\n":
            fp.seek(0, os.SEEK_END)
            fp.write(b"\n")
except Exception:
    pass
' "$file" 2>/dev/null || true
  fi
}

store_wallpaper() {
  local src=$1
  local wallpapers_dir=$HOME/.local/state/gesso/wallpapers
  mkdir -p "$wallpapers_dir"
  if [[ $(dirname -- "$src") == "$wallpapers_dir" && -f $src ]]; then
    printf '%s\n' "$src"
    return 0
  fi
  local hash
  hash=$(python3 -c 'import hashlib, sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest()[:12])' "$src" 2>/dev/null || true)
  if [[ -z $hash ]]; then
    hash="wp"
  fi
  local dest="$wallpapers_dir/${hash}-$(basename "$src")"
  cp -f "$src" "$dest"
  printf '%s\n' "$dest"
}

toml_quoted() {
  local file=$1
  local key=$2
  grep -E "^${key}[[:space:]]*=" "$file" | head -n1 | cut -d'"' -f2 || true
}

vscode_dirs=("$HOME/.config/Code/User" "$HOME/.var/app/com.visualstudio.code/config/Code/User")
vscode_backups=("$HOME/.local/state/gesso/vscode-colorCustomizations.json" "$HOME/.local/state/gesso/vscode-flatpak-colorCustomizations.json")
vscode_staged=("" "")

rm -rf "$next"
mkdir -p "$next"
if [[ -d $builtin_dir ]]; then
  cp -a "$builtin_dir/." "$next/"
fi
if [[ -d $user_dir ]]; then
  cp -a "$user_dir/." "$next/"
fi
if [[ ! -f $next/colors.toml ]]; then
  printf 'colors.toml missing after overlay\n' >&2
  rm -rf "$next"
  exit 1
fi

mode=$(toml_quoted "$next/colors.toml" mode)
accent=$(toml_quoted "$next/colors.toml" accent)
background=$(toml_quoted "$next/colors.toml" background)
foreground=$(toml_quoted "$next/colors.toml" foreground)
if [[ -z $mode || $mode != "dark" && $mode != "light" || -z $accent || -z $background || -z $foreground ]]; then
  printf 'colors.toml missing required keys\n' >&2
  rm -rf "$next"
  exit 1
fi

export GESSO_NEXT_THEME=$next
if ! gesso-theme-set-templates; then
  rm -rf "$next"
  exit 1
fi

live_colors=$HOME/.local/share/color-schemes/Gesso.colors
aside=
fail_publish() {
  local staged
  if [[ -n $aside ]]; then
    cp "$aside" "$live_colors"
    rm -f "$aside"
  else
    rm -f "$live_colors"
  fi
  for staged in "${vscode_staged[@]}"; do
    if [[ -n $staged ]]; then
      rm -f "$staged"
    fi
  done
  rm -rf "$next" "$next_undo"
  if (($# > 0)); then
    printf '%s\n' "$1" >&2
  fi
  exit 1
}

mkdir -p "$HOME/.local/share/color-schemes"
if [[ -f $live_colors ]]; then
  aside=$(mktemp "$HOME/.local/state/gesso/Gesso.colors.XXXXXX")
  cp "$live_colors" "$aside"
fi
if [[ -f $next/Gesso.colors ]]; then
  cp "$next/Gesso.colors" "$live_colors"
fi

if [[ -z ${GESSO_THEME_HEADLESS:-} ]]; then
  if ! command -v plasma-apply-colorscheme >/dev/null; then
    fail_publish 'plasma-apply-colorscheme is not available'
  fi
  # Plasma refuses to re-apply a scheme that is already current, so a
  # Gesso-to-Gesso switch would leave the previous colors on screen. Bounce
  # through the Breeze scheme for the new mode first.
  if plasma-apply-colorscheme -l 2>/dev/null | grep -q '^ \* Gesso ('; then
    if [[ $mode == "light" ]]; then
      plasma-apply-colorscheme BreezeLight || true
    else
      plasma-apply-colorscheme BreezeDark || true
    fi
  fi
  if ! plasma-apply-colorscheme Gesso; then
    fail_publish
  fi
fi

if [[ -f $next/vscode.json ]]; then
  for i in "${!vscode_dirs[@]}"; do
    if [[ -d ${vscode_dirs[i]} ]]; then
      vscode_staged[i]=$(mktemp "$HOME/.local/state/gesso/settings.json.XXXXXX")
      if ! gesso-vscode-colors merge "$next/vscode.json" "${vscode_dirs[i]}/settings.json" "${vscode_backups[i]}" "${vscode_staged[i]}"; then
        fail_publish
      fi
    fi
  done
fi

mkdir -p "$HOME/.local/share/konsole" "$HOME/.config"
if [[ -f $next/Gesso.colorscheme ]]; then
  cp "$next/Gesso.colorscheme" "$HOME/.local/share/konsole/Gesso.colorscheme"
fi
printf '%s\n' '[Appearance]' 'ColorScheme=Gesso' '' '[General]' 'Name=Gesso' >"$HOME/.local/share/konsole/Gesso.profile"
konsole_backup=$HOME/.local/state/gesso/konsole-default-profile
if [[ ! -f $konsole_backup ]]; then
  previous_profile=
  if [[ -f $HOME/.config/konsolerc ]]; then
    previous_profile=$(grep '^DefaultProfile=' "$HOME/.config/konsolerc" | head -n1 | cut -d= -f2- || true)
  fi
  if [[ -n $previous_profile ]]; then
    printf '%s\n' "$previous_profile" >"$konsole_backup"
  else
    : >"$konsole_backup"
  fi
fi
if [[ -f $HOME/.config/konsolerc ]]; then
  ensure_trailing_newline "$HOME/.config/konsolerc"
  if grep -q '^DefaultProfile=' "$HOME/.config/konsolerc"; then
    sed -i 's/^DefaultProfile=.*/DefaultProfile=Gesso.profile/' "$HOME/.config/konsolerc"
  else
    printf '%s\n' '[Desktop Entry]' 'DefaultProfile=Gesso.profile' >>"$HOME/.config/konsolerc"
  fi
else
  printf '%s\n' '[Desktop Entry]' 'DefaultProfile=Gesso.profile' >"$HOME/.config/konsolerc"
fi

# Prepare baseline wallpaper backup if not already present
wallpaper_baseline=$HOME/.local/state/gesso/wallpaper-baseline
if [[ ! -f $wallpaper_baseline ]]; then
  curr_wp=
  if [[ -f $state_dir/wallpaper && -s $state_dir/wallpaper ]]; then
    curr_wp=$(cat "$state_dir/wallpaper")
  elif [[ -f $HOME/.config/plasma-org.kde.plasma.desktop-appletsrc ]]; then
    curr_wp=$(grep -E '^[[:space:]]*Image=' "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" | head -n1 | cut -d= -f2- | sed 's|^file://||' || true)
  fi
  if [[ -n $curr_wp ]]; then
    printf '%s\n' "$curr_wp" >"$wallpaper_baseline"
  else
    : >"$wallpaper_baseline"
  fi
fi

# Prepare undo state capture before modifying terminal configs or theme state
rm -rf "$next_undo"
mkdir -p "$next_undo"
touch "$next_undo/undo-available"

if [[ -f $state_dir/theme.name ]]; then
  cp "$state_dir/theme.name" "$next_undo/previous-theme.name"
else
  printf 'unset\n' >"$next_undo/previous-theme.name"
fi

prev_wallpaper=
if [[ -f $state_dir/wallpaper && -s $state_dir/wallpaper ]]; then
  prev_wallpaper=$(cat "$state_dir/wallpaper")
elif [[ -f $HOME/.config/plasma-org.kde.plasma.desktop-appletsrc ]]; then
  prev_wallpaper=$(grep -E '^[[:space:]]*Image=' "$HOME/.config/plasma-org.kde.plasma.desktop-appletsrc" | head -n1 | cut -d= -f2- | sed 's|^file://||' || true)
fi
if [[ -n $prev_wallpaper ]]; then
  printf '%s\n' "$prev_wallpaper" >"$next_undo/wallpaper"
fi

kitty_baseline=$HOME/.local/state/gesso/kitty-baseline-state
kitty_state=
if [[ -f $next/kitty.conf ]]; then
  if command -v kitty >/dev/null || [[ -d $HOME/.config/kitty ]]; then
    mkdir -p "$HOME/.config/kitty"
    cp "$next/kitty.conf" "$HOME/.config/kitty/gesso-theme.conf"
    kitty_conf=$HOME/.config/kitty/kitty.conf
    if [[ ! -f $kitty_conf ]]; then
      kitty_state="created"
      printf 'include gesso-theme.conf\n' >"$kitty_conf"
    elif grep -qE '^[[:space:]]*include[[:space:]]+.*gesso-theme\.conf' "$kitty_conf"; then
      kitty_state="existed"
    else
      kitty_state="added"
      ensure_trailing_newline "$kitty_conf"
      printf 'include gesso-theme.conf\n' >>"$kitty_conf"
    fi
    if [[ ! -f $kitty_baseline ]]; then
      printf '%s\n' "$kitty_state" >"$kitty_baseline"
    fi
  fi
fi
if [[ -n $kitty_state ]]; then
  printf '%s\n' "$kitty_state" >"$next_undo/kitty-state"
fi

ghostty_baseline_state=$HOME/.local/state/gesso/ghostty-baseline-state
ghostty_baseline_theme=$HOME/.local/state/gesso/ghostty-baseline-theme
ghostty_state=
ghostty_prev_theme=
if [[ -f $next/ghostty ]]; then
  if command -v ghostty >/dev/null || [[ -d $HOME/.config/ghostty ]]; then
    mkdir -p "$HOME/.config/ghostty/themes"
    cp "$next/ghostty" "$HOME/.config/ghostty/themes/Gesso"
    ghostty_conf=$HOME/.config/ghostty/config
    if [[ ! -f $ghostty_conf ]]; then
      ghostty_state="created"
      if [[ ! -f $ghostty_baseline_state ]]; then
        printf 'created\n' >"$ghostty_baseline_state"
      fi
      printf 'theme = Gesso\n' >"$ghostty_conf"
    elif grep -qE '^[[:space:]]*theme[[:space:]]*=' "$ghostty_conf"; then
      ghostty_state="replaced"
      ghostty_prev_theme=$(grep -E '^[[:space:]]*theme[[:space:]]*=' "$ghostty_conf" | head -n1 | sed -E 's/^[[:space:]]*theme[[:space:]]*=[[:space:]]*//')
      if [[ ! -f $ghostty_baseline_state ]]; then
        printf 'replaced\n' >"$ghostty_baseline_state"
        printf '%s\n' "$ghostty_prev_theme" >"$ghostty_baseline_theme"
      fi
      sed -i -E 's/^[[:space:]]*theme[[:space:]]*=.*/theme = Gesso/' "$ghostty_conf"
    else
      ghostty_state="added"
      if [[ ! -f $ghostty_baseline_state ]]; then
        printf 'added\n' >"$ghostty_baseline_state"
      fi
      ensure_trailing_newline "$ghostty_conf"
      printf 'theme = Gesso\n' >>"$ghostty_conf"
    fi
  fi
fi
if [[ -n $ghostty_state ]]; then
  printf '%s\n' "$ghostty_state" >"$next_undo/ghostty-state"
fi
if [[ $ghostty_state == "replaced" ]]; then
  printf '%s\n' "$ghostty_prev_theme" >"$next_undo/ghostty-theme"
fi

foot_baseline=$HOME/.local/state/gesso/foot-baseline-state
foot_state=
if [[ -f $next/foot.ini ]]; then
  if command -v foot >/dev/null || [[ -d $HOME/.config/foot ]]; then
    mkdir -p "$HOME/.config/foot"
    cp "$next/foot.ini" "$HOME/.config/foot/gesso-theme.ini"
    foot_conf=$HOME/.config/foot/foot.ini
    if [[ ! -f $foot_conf ]]; then
      foot_state="created"
      if [[ ! -f $foot_baseline ]]; then
        printf 'created\n' >"$foot_baseline"
      fi
      printf '[main]\ninclude = ~/.config/foot/gesso-theme.ini\n' >"$foot_conf"
    elif grep -qE '^[[:space:]]*include[[:space:]]*=[[:space:]]*.*gesso-theme\.ini' "$foot_conf"; then
      foot_state="existed"
      if [[ ! -f $foot_baseline ]]; then
        printf 'existed\n' >"$foot_baseline"
      fi
    else
      foot_state="added"
      if [[ ! -f $foot_baseline ]]; then
        printf 'added\n' >"$foot_baseline"
      fi
      if grep -q '^\[main\]' "$foot_conf"; then
        sed -i '/^\[main\]/a include = ~\/.config\/foot\/gesso-theme.ini' "$foot_conf"
      elif grep -q -E '^[[:space:]]*\[' "$foot_conf"; then
        sed -i '1i [main]\ninclude = ~/.config/foot/gesso-theme.ini\n' "$foot_conf"
      else
        ensure_trailing_newline "$foot_conf"
        printf '[main]\ninclude = ~/.config/foot/gesso-theme.ini\n' >>"$foot_conf"
      fi
    fi
  fi
fi
if [[ -n $foot_state ]]; then
  printf '%s\n' "$foot_state" >"$next_undo/foot-state"
fi

for i in "${!vscode_dirs[@]}"; do
  if [[ -n ${vscode_staged[i]} ]]; then
    cp "$next/vscode.json" "${vscode_dirs[i]}/gesso-theme.json"
    mv "${vscode_staged[i]}" "${vscode_dirs[i]}/settings.json"
    vscode_staged[i]=
  fi
done

rm -rf "$current"
mv "$next" "$current"
printf '%s\n' "$name" >"$state_dir/theme.name"
if [[ -n $aside ]]; then
  rm -f "$aside"
fi

applied_wallpaper=
if [[ $wallpaper_mode == "theme" ]]; then
  shopt -s nullglob
  for wp in "$current/backgrounds"/*; do
    if [[ -f $wp ]]; then
      applied_wallpaper=$(store_wallpaper "$wp")
      break
    fi
  done
elif [[ $wallpaper_mode == "custom" ]]; then
  applied_wallpaper=$(store_wallpaper "$wallpaper_arg")
fi

if [[ -n $applied_wallpaper ]]; then
  printf '%s\n' "$applied_wallpaper" >"$state_dir/wallpaper"
  if [[ -z ${GESSO_THEME_HEADLESS:-} ]] && command -v plasma-apply-wallpaperimage >/dev/null; then
    plasma-apply-wallpaperimage "$applied_wallpaper" || true
  fi
fi

rm -rf "$undo_dir"
mv "$next_undo" "$undo_dir"

if [[ -z ${GESSO_THEME_HEADLESS:-} ]]; then
  if command -v gsettings >/dev/null; then
    gtk_backup=$HOME/.local/state/gesso/gtk-color-scheme
    if [[ ! -f $gtk_backup ]]; then
      gsettings get org.gnome.desktop.interface color-scheme >"$gtk_backup" 2>/dev/null || true
    fi
    if [[ $mode == "light" ]]; then
      gsettings set org.gnome.desktop.interface color-scheme prefer-light || true
    else
      gsettings set org.gnome.desktop.interface color-scheme prefer-dark || true
    fi
  fi
fi

if [[ -z ${GESSO_THEME_HEADLESS:-} ]] && command -v kitty >/dev/null && command -v kitten >/dev/null; then
  kitten @ set-colors --all "$HOME/.config/kitty/gesso-theme.conf" >/dev/null 2>&1 || true
fi

for hook in "$HOME/.config/gesso/hooks"/theme-set*; do
  [[ -x $hook ]] || continue
  "$hook" "$name"
done
